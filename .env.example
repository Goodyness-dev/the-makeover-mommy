# The Makeover Mommy
# Backend host: set ADMIN_INITIAL_PASSWORD for first initialization only.
PORT=5001
ADMIN_INITIAL_PASSWORD=
# Vercel server-side variable: HTTPS origin of this studio's deployed Node backend.
# Requests fail safely when it is unset. Do not point this to another business.
STUDIO_API_URL=
# Email and Telegram integrations are configured inside the studio settings.
